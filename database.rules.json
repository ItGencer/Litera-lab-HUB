{
  "rules": {
    ".read": false,
    ".write": false,

    "Users": {
      ".read": "auth !== null && (root.child('Users').child(auth.uid).child('role').val() === 'admin' || root.child('Users').child(auth.uid).child('role').val() === 'moderator')",
      ".write": "auth !== null && root.child('Users').child(auth.uid).child('role').val() === 'admin'",

      "$uid": {
        ".read": "auth !== null && $uid === auth.uid",
        ".write": "auth !== null && ($uid === auth.uid || root.child('Users').child(auth.uid).child('role').val() === 'admin')"
      }
    },

    "Works": {
      ".read": true,

      "$workId": {
        ".write": "auth !== null && (!data.exists() || data.child('createdBy').val() === auth.uid || root.child('Users').child(auth.uid).child('role').val() === 'admin' || root.child('Users').child(auth.uid).child('role').val() === 'moderator')",
        ".validate": "newData.hasChildren(['title', 'description', 'createdBy']) && newData.child('createdBy').val() === auth.uid"
      }
    },

    "News": {
      ".read": true,

      "$newsId": {
        ".write": "auth !== null && (root.child('Users').child(auth.uid).child('role').val() === 'admin' || root.child('Users').child(auth.uid).child('role').val() === 'moderator')",
        ".validate": "newData.hasChildren(['title', 'text', 'author'])"
      }
    }
  }
}